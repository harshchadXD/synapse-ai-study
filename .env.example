NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Primary AI Provider: NVIDIA NIM (auto-rotates between Llama 3.3 70B, Mistral Large 2, Nemotron 70B, DeepSeek R1)
NVIDIA_API_KEY=your-nvidia-api-key

# Secondary AI Provider: Google Gemini API (Google Cloud / Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key

# Tertiary AI Provider / Fallback: Groq Cloud API
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
